rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Site settings documents
    match /settings/site {
      allow read: if true;
      allow write: if true;
    }

    // 3. Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Coupons collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
